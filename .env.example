# Primary LLM Provider (Free default: Gemini)
# Options: gemini (free), anthropic
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.6-flash

# Google Gemini API Key (Free tier available at https://aistudio.google.com)
GEMINI_API_KEY=

# Anthropic Claude API Key (Optional alternative)
# ANTHROPIC_API_KEY=

# Tavily Web Search API Key (Free tier available at https://tavily.com)
TAVILY_API_KEY=

# Email Notifications via Resend (Free tier available at https://resend.com)
RESEND_API_KEY=
RESEND_RECIPIENT_EMAIL=
# SENDER_EMAIL="Founder Intelligence <onboarding@resend.dev>"

# Slack Webhook Notification URL (Optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
